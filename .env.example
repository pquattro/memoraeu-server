# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-characters-long!!
REGISTRATION_OPEN=true

# ── Embedding ─────────────────────────────────────────────────────────────────
# Provider: "ollama" (local) or "mistral" (cloud)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_URL=http://localhost:11434

# Mistral (only if EMBED_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ── Storage ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=memories
SQLITE_PATH=/data/memoraeu.db

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Sécurité MCP (protection DNS rebinding) ───────────────────────────────────
# Validation des en-têtes Host et Origin sur les endpoints /mcp/.
# Un Origin absent est accepté (appels serveur-à-serveur). Un Host absent de
# la liste est rejeté en 421 : ajoutez votre domaine si vous exposez le serveur.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:8000,127.0.0.1:8000
MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://claude.ai
